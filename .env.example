# Copy to .env (never committed) and fill in the key: cp .env.example .env

# Postgres for host-side runs (docker compose overrides it with the in-network `db` host).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/label_check

# Primary vision provider: gemini | groq.
VISION_PROVIDER=gemini
# Optional second provider (must differ from VISION_PROVIDER; empty = none). Groq's model
# takes at most 3 photos per request: a 4-photo request with the primary down fails with
# vision_rate_limited.
VISION_FALLBACK_PROVIDER=

# Google AI Studio key, free tier, no card — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model. Free tier of gemini-3.5-flash-lite: 15 RPM, 250K TPM, 500 RPD (01.10.2026).
VISION_MODEL=gemini-3.5-flash-lite

# Groq key, free, no card — https://console.groq.com/keys (needed only for the fallback)
GROQ_API_KEY=
# The only vision model on Groq (<= 3 photos per request, ~2048 tokens per photo).
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Timeout of one vision call, seconds (retries on 503/timeout are capped at 60 s in total).
VISION_TIMEOUT_SECONDS=60

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
